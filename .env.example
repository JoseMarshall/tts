# Copy to .env and adjust. All vars are prefixed with TTS_.

# Backend: "mock" (no GPU, tone generator) or "qwen" (real model).
TTS_BACKEND=mock

# --- Only used when TTS_BACKEND=qwen ---
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Extra models a request may select via the "model" field (comma-separated).
# The default (TTS_MODEL_ID) is always allowed. Example:
# TTS_MODELS=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice,Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_MODELS=
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
TTS_ATTN_IMPLEMENTATION=flash_attention_2

# --- Audio ---
TTS_SAMPLE_RATE=24000
TTS_STREAM_CHUNK_SAMPLES=1200

# --- Generation defaults ---
TTS_DEFAULT_LANGUAGE=Auto
TTS_DEFAULT_SPEAKER=Vivian

# --- Server ---
TTS_HOST=0.0.0.0
TTS_PORT=8000
TTS_MAX_QUEUE=32

# Comma-separated bearer tokens. Empty = auth disabled.
TTS_API_KEYS=
