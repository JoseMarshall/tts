# Copy to .env and adjust. All vars are prefixed with TTS_.

# Backend: "mock" (no deps, tone generator), "qwen" (Qwen3-TTS, GPU),
# or "kokoro" (Kokoro-82M, CPU/GPU). See requirements.txt for per-backend deps.
TTS_BACKEND=mock

# Default model, and an optional comma-separated allow-list of extra models a
# request may select via the "model" field (the default is always allowed).
#   qwen:   TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
#   kokoro: TTS_MODEL_ID=hexgrad/Kokoro-82M
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_MODELS=

# --- Only used by GPU backends (qwen) ---
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
TTS_ATTN_IMPLEMENTATION=sdpa

# --- Audio ---
TTS_SAMPLE_RATE=24000
TTS_STREAM_CHUNK_SAMPLES=1200

# --- Generation defaults (empty = let the backend choose its own default) ---
TTS_DEFAULT_LANGUAGE=
TTS_DEFAULT_SPEAKER=

# --- Server ---
TTS_HOST=0.0.0.0
TTS_PORT=8000
TTS_MAX_QUEUE=32

# Comma-separated bearer tokens. Empty = auth disabled.
TTS_API_KEYS=
