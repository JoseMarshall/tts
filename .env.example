# Copy to .env and adjust. All vars are prefixed with TTS_.

# DEFAULT backend, used when a request doesn't select one:
#   "mock" (no deps), "qwen" (Qwen3-TTS, GPU), "kokoro" (Kokoro-82M, CPU/GPU),
#   "dia" (Dia2-1B, CUDA only). See requirements.txt for per-backend deps.
TTS_BACKEND=mock

# Extra backends a CLIENT may pick per request (comma-separated). Each becomes
# selectable by name in the request "model" field (e.g. model="kokoro"), using
# that backend's default model. The default backend is always enabled.
#   e.g. TTS_BACKEND=qwen  TTS_BACKENDS=kokoro,dia
TTS_BACKENDS=

# Default model for the default backend (empty = that backend's own default,
# e.g. kokoro -> hexgrad/Kokoro-82M).
TTS_MODEL_ID=

# Extra selectable specific models (comma-separated), each "backend:model_id":
#   TTS_MODELS=qwen:Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice,kokoro:hexgrad/Kokoro-82M
TTS_MODELS=

# --- Only used by GPU backends (qwen) ---
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
TTS_ATTN_IMPLEMENTATION=sdpa

# --- Audio ---
TTS_SAMPLE_RATE=24000
TTS_STREAM_CHUNK_SAMPLES=1200

# Independent instances of each model. 1 = generation is serialised (the
# historical behaviour). Higher = that many concurrent generations, and that
# many times the VRAM. Only applies to backends that declare SUPPORTS_REPLICAS;
# check GET /health -> replicas to see what actually loaded.
TTS_ENGINE_REPLICAS=1

# Word-level timing marks on the WebSocket API (engines that provide them,
# e.g. Kokoro). 1 = on (default), 0 = off.
TTS_EMIT_MARKS=1

# --- Generation defaults (empty = let the backend choose its own default) ---
TTS_DEFAULT_LANGUAGE=
TTS_DEFAULT_SPEAKER=

# --- Server ---
TTS_HOST=0.0.0.0
TTS_PORT=8000
TTS_MAX_QUEUE=32

# Comma-separated bearer tokens. Empty = auth disabled.
TTS_API_KEYS=

# =============================================================================
# STT (Speech-to-text) — all variables use the ``STT_`` prefix.
# =============================================================================

# DEFAULT backend (when a request doesn't select one):
#   "mock" (no deps), "voxtral" (Voxtral-Small via transformers, GPU),
#   "whisper" (Whisper-large-v3 via native or transformers, GPU/CPU).
STT_BACKEND=mock

# Extra backends a CLIENT may pick per request (comma-separated). Each becomes
# selectable by name in the STT request "model" field (e.g. model="whisper").
STT_BACKENDS=

# Specific model id for the default backend (empty -> its own default).
STT_MODEL_ID=

# Additional selectable models as ``backend:model_id`` entries, e.g.:
#   STT_MODELS=stt:voxtral:mistralai/Voxtral-Small-24B-2507
STT_MODELS=

# ----- Only used by GPU backends (voxtral, whisper) ---
STT_DEVICE=cuda:0
STT_DTYPE=bfloat16

# ---- Audio settings for STT ---
STT_SAMPLE_RATE=16000
STT_STREAM_CHUNK_SAMPLES=1600
STT_MAX_INPUT_SECONDS=30.0

# ---- Voice activity detection (/v1/stt_ws turn endpointing) ---
# Which detector to build when a session enables VAD. Nothing is imported until
# then, so the server still starts with none of these installed.
#   silero  -- accurate, CPU, ~2 MB:  pip install silero-vad
#   energy  -- RMS + adaptive noise floor, no dependencies
#   webrtc  -- pip install webrtcvad
STT_VAD=silero
# Auto-flush changes session semantics (transcribe on silence instead of on an
# explicit `flush`), so clients opt in per session via init.vad.enabled.
# Set to 1 for a deployment where every client wants hands-free turn-taking.
STT_VAD_AUTO_FLUSH=0
STT_VAD_THRESHOLD=0.5
STT_VAD_SPEECH_MS=120          # speech needed before onset is believed
STT_VAD_SILENCE_MS=700         # trailing silence that ends a turn
STT_VAD_PRE_ROLL_MS=300        # audio kept from before onset (unclips the first phoneme)
STT_VAD_MAX_UTTERANCE_S=30.0   # hard cap; also bounds the audio buffer

# ---- Concurrency / Server ---
STT_MAX_QUEUE=32
STT_HOST=0.0.0.0
STT_PORT=8000

# Comma-separated bearer tokens. Empty = auth disabled.
STT_API_KEYS=
