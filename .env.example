# Copy to .env and adjust. All vars are prefixed with TTS_.

# DEFAULT backend, used when a request doesn't select one:
#   "mock" (no deps), "qwen" (Qwen3-TTS, GPU), "kokoro" (Kokoro-82M, CPU/GPU),
#   "dia" (Dia-1.6B, GPU). See requirements.txt for per-backend deps.
TTS_BACKEND=mock

# Extra backends a CLIENT may pick per request (comma-separated). Each becomes
# selectable by name in the request "model" field (e.g. model="kokoro"), using
# that backend's default model. The default backend is always enabled.
#   e.g. TTS_BACKEND=qwen  TTS_BACKENDS=kokoro,dia
TTS_BACKENDS=

# Default model for the default backend (empty = that backend's own default,
# e.g. kokoro -> hexgrad/Kokoro-82M).
TTS_MODEL_ID=

# Extra selectable specific models (comma-separated), each "backend:model_id":
#   TTS_MODELS=qwen:Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice,kokoro:hexgrad/Kokoro-82M
TTS_MODELS=

# --- Only used by GPU backends (qwen) ---
TTS_DEVICE=cuda:0
TTS_DTYPE=bfloat16
TTS_ATTN_IMPLEMENTATION=sdpa

# --- Audio ---
TTS_SAMPLE_RATE=24000
TTS_STREAM_CHUNK_SAMPLES=1200

# --- Generation defaults (empty = let the backend choose its own default) ---
TTS_DEFAULT_LANGUAGE=
TTS_DEFAULT_SPEAKER=

# --- Server ---
TTS_HOST=0.0.0.0
TTS_PORT=8000
TTS_MAX_QUEUE=32

# Comma-separated bearer tokens. Empty = auth disabled.
TTS_API_KEYS=

# =============================================================================
# SST (Speech-to-text) — all variables use the ``SST_`` prefix.
# =============================================================================

# DEFAULT backend (when a request doesn't select one):
#   "mock" (no deps), "voxtral" (Voxtral-Small via transformers, GPU),
#   "whisper" (Whisper-large-v3 via native or transformers, GPU/CPU).
SST_BACKEND=mock

# Extra backends a CLIENT may pick per request (comma-separated). Each becomes
# selectable by name in the SST request "model" field (e.g. model="whisper").
SST_BACKENDS=

# Specific model id for the default backend (empty -> its own default).
SST_MODEL_ID=

# Additional selectable models as ``backend:model_id`` entries, e.g.:
#   SST_MODELS=sst:voxtral:mistralai/Voxtral-Small-24B-2507
SST_MODELS=

# ----- Only used by GPU backends (voxtral, whisper) ---
SST_DEVICE=cuda:0
SST_DTYPE=bfloat16

# ---- Audio settings for SST ---
SST_SAMPLE_RATE=16000
SST_STREAM_CHUNK_SAMPLES=1600
SST_MAX_INPUT_SECONDS=30.0

# ---- Concurrency / Server ---
SST_MAX_QUEUE=32
SST_HOST=0.0.0.0
SST_PORT=8000

# Comma-separated bearer tokens. Empty = auth disabled.
SST_API_KEYS=
